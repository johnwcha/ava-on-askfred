{
  "routes": [
    {
      "route": "/feedback-admin",
      "redirect": "/.auth/login/aad?post_login_redirect_uri=/feedback-results.html"
    },
    {
      "route": "/feedback-results.html",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/feedback-results",
      "methods": ["GET"],
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/feedback-admin-access",
      "methods": ["GET"],
      "allowedRoles": ["authenticated"]
    }
  ],
  "platform": {
    "apiRuntime": "node:22"
  }
}
